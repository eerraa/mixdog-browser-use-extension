{
  "hooks": {
    "PreToolUse": [{
      "matcher": "^mcp__plugin-win-browser__browse$",
      "hooks": [{ "type": "command", "command": "${MIXDOG_PLUGIN_ROOT}/bin/bridge.exe", "args": ["--hook"], "timeout": 5 }]
    }],
    "SessionStart": [{
      "hooks": [{ "type": "command", "command": "${MIXDOG_PLUGIN_ROOT}/bin/bridge.exe", "args": ["--hook"], "timeout": 2 }]
    }],
    "UserPromptSubmit": [{
      "hooks": [{ "type": "command", "command": "${MIXDOG_PLUGIN_ROOT}/bin/bridge.exe", "args": ["--hook"], "timeout": 2 }]
    }],
    "SubagentStart": [{
      "hooks": [{ "type": "command", "command": "${MIXDOG_PLUGIN_ROOT}/bin/bridge.exe", "args": ["--hook"], "timeout": 2 }]
    }],
    "Stop": [{
      "hooks": [{ "type": "command", "command": "${MIXDOG_PLUGIN_ROOT}/bin/bridge.exe", "args": ["--hook"], "timeout": 2 }]
    }],
    "StopFailure": [{
      "hooks": [{ "type": "command", "command": "${MIXDOG_PLUGIN_ROOT}/bin/bridge.exe", "args": ["--hook"], "timeout": 2 }]
    }],
    "SessionEnd": [{
      "hooks": [{ "type": "command", "command": "${MIXDOG_PLUGIN_ROOT}/bin/bridge.exe", "args": ["--hook"], "timeout": 2 }]
    }],
    "SubagentStop": [{
      "hooks": [{ "type": "command", "command": "${MIXDOG_PLUGIN_ROOT}/bin/bridge.exe", "args": ["--hook"], "timeout": 2 }]
    }]
  }
}
